# Supabase → Project Settings → API (use a chave publicável / anon)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modo demonstração: dados fictícios no navegador, sem Supabase (1 = ligado)
NEXT_PUBLIC_DEMO=

# Só para GitHub Pages em subpasta (ex.: /trilha). Deixe vazio em domínio próprio.
NEXT_PUBLIC_BASE_PATH=

# Google Drive (salvar projetos no Drive do aluno e abrir sem o Supabase).
# Client ID OAuth do tipo "Aplicativo da Web", com a Google Drive API ativada.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
